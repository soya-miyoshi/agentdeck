{
  "name": "agentdeck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client",
    "dev": "vite src/client",
    "build": "vite build src/client",
    "lint": "eslint . && prettier --check \"**/*.{ts,mjs,json}\"",
    "format": "prettier --write .",
    "test": "node --test \"src/**/*.test.ts\"",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.26.1",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "vue": "^3.5.40",
    "ws": "^8.21.2"
  }
}
